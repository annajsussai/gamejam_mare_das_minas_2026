<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Prévia — Introdução do Jogo</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap');

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    height: 100%;
    background: #02070b;
  }

  body {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 6px;
    overflow: hidden;
  }

  /* ---------- MOLDURA EXTERNA (mesma proporção/estilo do index) ---------- */
  #gameFrame {
    width: 100%;
    max-width: 1024px; /* equivalente ao max-w-5xl do index */
    max-height: 100dvh;
    background: #0f172a; /* slate-900 */
    border: 2px solid #d97706; /* amber-600 */
    border-radius: 10px;
    padding: 6px;
    box-shadow: 0 10px 30px rgba(0,0,0,.6);
  }

  @media (min-width: 640px) {
    #gameFrame { border-width: 4px; padding: 12px; }
  }

  /* ---------- TELA (mesma proporção aspect-[16/9] do canvas do index) ---------- */
  #introScreen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid #334155; /* slate-700 */
    font-family: 'VT323', monospace;
    color: #f4f1ea;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.3);
  }

  /* ---------- CENÁRIO DE FUNDO ---------- */
  #introBg {
    position: absolute;
    inset: 0;
    background-image: url('assets/telainicial.png');
    background-size: cover;
    background-position: center;
    image-rendering: pixelated;
    filter: saturate(0.95) brightness(0.75);
    transform: scale(1.04);
  }

  /* leve movimento de "respiração" no fundo, tipo maré */
  @keyframes bgDrift {
    0%   { transform: scale(1.04) translateY(0px); }
    50%  { transform: scale(1.06) translateY(-6px); }
    100% { transform: scale(1.04) translateY(0px); }
  }
  #introBg { animation: bgDrift 14s ease-in-out infinite; }

  #introVinheta {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(2,7,11,0.2) 0%, rgba(2,7,11,0.75) 78%),
      linear-gradient(180deg, rgba(2,7,11,0.4) 0%, rgba(2,7,11,0.2) 30%, rgba(2,7,11,0.2) 70%, rgba(2,7,11,0.6) 100%);
  }

  /* scanlines sutis pra dar clima retrô sem pesar no texto */
  #introScan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0,0,0,0.14) 0px,
      rgba(0,0,0,0.14) 1px,
      rgba(0,0,0,0) 2px,
      rgba(0,0,0,0) 3px
    );
    opacity: 0.35;
    mix-blend-mode: multiply;
  }

  /* ---------- CONTEÚDO ---------- */
  #introContent {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(92%, 640px);
    padding: 0 10px;
  }

  #introNarrationBox {
    position: relative;
    min-height: 110px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 46px 14px 20px;
    background: rgba(4, 12, 18, 0.75);
    border: 2px solid rgba(217, 119, 6, 0.75);
    border-radius: 6px;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.4) inset, 0 8px 24px rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity .7s ease;
  }

  #introNarrationBox.visible { opacity: 1; }

  #introNarration {
    font-size: clamp(14px, 2.1vw, 22px);
    line-height: 1.3;
    text-align: center;
    text-shadow: 2px 2px 0 #000, 0 0 16px rgba(0,0,0,.7);
    letter-spacing: 0.3px;
  }

  #introNarration .cursor {
    display: inline-block;
    width: 0.5ch;
    margin-left: 2px;
    animation: blink 0.9s steps(1) infinite;
    color: #facc15;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* ---------- BOTÃO DE AVANÇAR (setinha no canto inferior direito) ---------- */
  #advanceBtn {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid #d97706;
    background: rgba(2, 7, 11, 0.75);
    color: #facc15;
    font-size: 14px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity .3s ease, transform .12s ease, background .12s ease;
  }

  #introNarrationBox.visible #advanceBtn {
    opacity: 1;
    pointer-events: auto;
  }

  #advanceBtn:hover {
    background: rgba(217, 119, 6, 0.25);
    transform: scale(1.08);
  }

  #advanceBtn:active {
    transform: scale(0.92);
  }

  @keyframes arrowPulse {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(2px); }
  }
  #advanceBtn span {
    display: inline-block;
    animation: arrowPulse 1s ease-in-out infinite;
  }

  #skipHint {
    margin-top: 8px;
    font-size: clamp(11px, 1.4vw, 14px);
    color: rgba(244, 241, 234, 0.75);
    opacity: 0;
    transition: opacity .6s ease;
    height: 1.3em;
    text-shadow: 1px 1px 0 #000;
  }
  #skipHint.visible { opacity: 1; }

  /* ---------- PLACA DE OBJETIVOS ---------- */
  #objectiveBox {
    display: none;
    width: 100%;
    margin: 0 auto;
    background: rgba(5, 15, 24, .9);
    border: 3px solid #d97706;
    border-radius: 10px;
    padding: 16px 18px 20px;
    box-shadow: 0 0 0 2px #7c2d12 inset, 0 10px 30px rgba(0,0,0,.6);
    animation: objectiveAppear .6s ease forwards;
    position: relative;
    text-align: center;
  }

  #objectiveBox::before,
  #objectiveBox::after {
    content: "";
    position: absolute;
    top: -12px;
    width: 12px;
    height: 18px;
    background: #7c4a2d;
    border: 2px solid #4a2c18;
    border-radius: 2px;
  }
  #objectiveBox::before { left: 18px; }
  #objectiveBox::after  { right: 18px; }

  #objectiveBox h2 {
    margin: 0 0 12px;
    color: #facc15;
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(11px, 1.8vw, 18px);
    text-align: center;
    text-shadow: 2px 2px 0 #7c2d12;
  }

  #objectiveGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 14px;
  }

  #objectiveGrid p {
    margin: 0;
    padding: 8px 8px;
    font-size: clamp(12px, 1.8vw, 17px);
    line-height: 1.2;
    text-align: center;
    border: 1px solid rgba(217, 119, 6, .5);
    border-radius: 5px;
    background: rgba(2, 7, 11, .7);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  #objectiveGrid p::before {
    content: "▸";
    color: #facc15;
  }

  @media (max-width: 560px) {
    #objectiveGrid { grid-template-columns: 1fr; }
  }

  /* ---------- BOTÕES COM O SPRITE bg_btn.png ---------- */
  .intro-btn {
    display: none;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: 16px auto 0;
    min-width: 170px;
    background: transparent;
    color: #4a2410;
    font-family: 'Press Start 2P', monospace;
    font-weight: bold;
    border: none;
    padding: 14px 24px 18px;
    cursor: pointer;
    font-size: clamp(9px, 1.5vw, 13px);
    text-shadow: 1px 1px 0 rgba(255,255,255,0.25);
    background-image: url('assets/bg_btn.png');
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    image-rendering: pixelated;
    transition: transform .12s ease, filter .12s ease;
    animation: objectiveAppear .6s ease forwards;
  }

  .intro-btn:hover {
    transform: translateY(-2px) scale(1.04);
    filter: brightness(1.12);
  }

  .intro-btn:active {
    transform: translateY(1px) scale(0.98);
    filter: brightness(0.94);
  }

  @keyframes objectiveAppear {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  #introScreen.fadeOut {
    animation: introFadeOut .6s ease forwards;
  }
  @keyframes introFadeOut {
    to { opacity: 0; }
  }
</style>
</head>
<body>

<div id="gameFrame">
  <div id="introScreen">
    <div id="introBg"></div>
    <div id="introVinheta"></div>
    <div id="introScan"></div>

    <div id="introContent">

      <div id="introNarrationBox">
        <div id="introNarration"></div>
        <button id="advanceBtn" type="button" aria-label="Avançar texto"><span>&raquo;</span></button>
      </div>
      <div id="skipHint">clique ou toque na seta para avançar</div>

      <button id="showObjectivesBtn" class="intro-btn">VER OBJETIVOS</button>

      <div id="objectiveBox">
        <h2>SEU OBJETIVO</h2>
        <div id="objectiveGrid">
          <p>Avalie as embarcações</p>
          <p>Analise suas informações</p>
          <p>Observe a maré</p>
          <p>Proteja o ecossistema</p>
        </div>
      </div>

      <button id="startIntroBtn" class="intro-btn">COMEÇAR</button>
    </div>
  </div>
</div>

<script>
  // ---------- referências dos elementos ----------
  var introScreen = document.getElementById('introScreen');
  var introNarrationBox = document.getElementById('introNarrationBox');
  var introNarration = document.getElementById('introNarration');
  var advanceBtn = document.getElementById('advanceBtn');
  var skipHint = document.getElementById('skipHint');
  var showObjectivesBtn = document.getElementById('showObjectivesBtn');
  var objectiveBox = document.getElementById('objectiveBox');
  var startIntroBtn = document.getElementById('startIntroBtn');

  // ---------- textos da narração ----------
  var introTexts = [
    "“O porto desperta antes mesmo do sol. Embarcações começam a surgir no horizonte. Algumas trazem alimentos, medicamentos e equipamentos essenciais. Outras podem carregar ameaças para as águas e para a vida costeira.”",
    "“Mas nem sempre é possível saber o que existe por trás de cada carga. Nos próximos três dias, o porto estará sob sua responsabilidade. Observe. Investigue. Decida.”"
  ];

  // ---------- variáveis globais de controle da máquina de escrever ----------
  var indiceTextoAtual = 0;
  var indiceCaractereAtual = 0;
  var timeoutDigitacao = null;
  var timeoutEspera = null;
  var timeoutTransicao = null;
  var digitando = false;
  var velocidadeDigitacao = 34;

  function limparTimersPendentes() {
    clearTimeout(timeoutDigitacao);
    clearTimeout(timeoutEspera);
    clearTimeout(timeoutTransicao);
  }

  function digitarTexto(texto) {
    digitando = true;
    indiceCaractereAtual = 0;
    introNarration.innerHTML = '<span class="letras"></span><span class="cursor">▌</span>';
    var spanLetras = introNarration.querySelector('.letras');

    function passo() {
      if (indiceCaractereAtual < texto.length) {
        spanLetras.textContent += texto.charAt(indiceCaractereAtual);
        indiceCaractereAtual++;
        timeoutDigitacao = setTimeout(passo, velocidadeDigitacao);
      } else {
        digitando = false;
        agendarProximoTexto();
      }
    }
    passo();
  }

  function completarDigitacaoAgora() {
    clearTimeout(timeoutDigitacao);
    var spanLetras = introNarration.querySelector('.letras');
    if (spanLetras) spanLetras.textContent = introTexts[indiceTextoAtual];
    digitando = false;
  }

  function agendarProximoTexto() {
    timeoutEspera = setTimeout(function () {
      esconderEIrParaProximo();
    }, 3700);
  }

  function esconderEIrParaProximo() {
    introNarrationBox.classList.remove('visible');
    timeoutTransicao = setTimeout(function () {
      mostrarTexto(indiceTextoAtual + 1);
    }, 600);
  }

  function avancar() {
    if (indiceTextoAtual >= introTexts.length) return;
    if (digitando) {
      completarDigitacaoAgora();
    } else {
      clearTimeout(timeoutEspera);
      esconderEIrParaProximo();
    }
  }

  function mostrarTexto(indice) {
    limparTimersPendentes();

    if (indice >= introTexts.length) {
      indiceTextoAtual = indice;
      skipHint.classList.remove('visible');
      introNarrationBox.classList.remove('visible');
      setTimeout(function () {
        introNarrationBox.style.display = 'none';
        skipHint.style.display = 'none';
        showObjectivesBtn.style.display = 'flex';
      }, 500);
      return;
    }

    indiceTextoAtual = indice;
    introNarrationBox.classList.add('visible');
    skipHint.classList.add('visible');
    digitarTexto(introTexts[indice]);
  }

  introNarrationBox.style.cursor = 'pointer';
  introNarrationBox.addEventListener('click', function (e) {
    if (e.target === advanceBtn || advanceBtn.contains(e.target)) return;
    avancar();
  });

  advanceBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    avancar();
  });

  showObjectivesBtn.addEventListener('click', function () {
    showObjectivesBtn.style.display = 'none';
    objectiveBox.style.display = 'block';
    startIntroBtn.style.display = 'flex';
  });

  startIntroBtn.addEventListener('click', function () {
    introScreen.classList.add('fadeOut');
    setTimeout(function () {
      introScreen.style.display = 'none';
      console.log("Jogo iniciado!");
    }, 600);
  });

  // ---------- INICIALIZAÇÃO COM DELAY DE 1.5s PARA MOSTRAR SÓ O FUNDO ----------
  setTimeout(function() {
    mostrarTexto(0);
  }, 1500);
</script>
</body>
</html>
